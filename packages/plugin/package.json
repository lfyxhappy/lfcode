{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@lfcode-ai/plugin",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsc"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./library": {
      "bun": "./src/library.ts",
      "default": "./dist/library.js"
    },
    "./manifest": {
      "bun": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./tool": {
      "bun": "./src/tool.ts",
      "default": "./dist/tool.js"
    },
    "./tui": {
      "bun": "./src/tui.ts",
      "default": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@lfcode-ai/sdk": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.3",
    "@opentui/keymap": ">=0.4.3",
    "@opentui/solid": ">=0.4.3"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
