{
  "name": "@lfcode-ai/desktop",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lfyxhappy/lfcode",
  "author": {
    "name": "Lfcode",
    "email": "noreply@users.noreply.github.com"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "bun test --timeout 30000",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "clean:dist": "bun ./scripts/clean-dist.ts",
    "preserve-runtime": "bun ./scripts/preserve-win-runtime.ts",
    "preserve-config": "bun ./scripts/sync-local-config.ts",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun run clean:dist && bun run preserve-config && bun run build && bun ./scripts/prepare-bundled-python.ts && bun ./scripts/prepare-bundled-git.ts && electron-builder --config electron-builder.config.ts && bun ./scripts/cleanup-bundled-python.ts && bun ./scripts/cleanup-bundled-git.ts",
    "package:mac": "bun run clean:dist && bun run preserve-config && bun run build && electron-builder --mac --config electron-builder.config.ts",
    "restore-runtime": "bun ./scripts/restore-win-runtime.ts",
    "sync:win-use-copy": "bun ./scripts/sync-win-use-copy.ts",
    "app:control": "bun ./scripts/app-control.ts",
    "automation:client": "bun ./scripts/automation-client.ts",
    "automation:smoke": "bun ./scripts/automation-smoke.ts",
    "automation:browser-smoke": "bun ./scripts/browser-tools-smoke.ts",
    "automation:installed-smoke": "bun ./scripts/installed-app-smoke.ts",
    "cli:install-dev": "bun ./scripts/install-cli-dev.ts",
    "package:win:fast": "bun ./scripts/package-win-fast.ts",
    "sync:win-use-copy:fast": "bun run package:win:fast && bun run sync:win-use-copy",
    "package:win": "bun run preserve-runtime && bun run clean:dist && bun run preserve-config && bun run build && bun ./scripts/prepare-bundled-python.ts && bun ./scripts/prepare-bundled-git.ts && electron-builder --win --publish never --config electron-builder.config.ts && bun run restore-runtime && bun ./scripts/prune-win-dist.ts && bun ./scripts/cleanup-bundled-python.ts && bun ./scripts/cleanup-bundled-git.ts",
    "package:linux": "bun run clean:dist && bun run preserve-config && bun run build && electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "^10",
    "electron-updater": "^6",
    "electron-window-state": "^5.0.3",
    "marked": "^15"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "@lfcode-ai/app": "workspace:*",
    "@lfcode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "41.2.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
