{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "volcengine-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volcano Engine",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "cbd0e8ce-1645-4583-93fd-8bb8ae701bd7",
      },
      "models": {
        "ark-code-latest": {
          "name": "ark-code-latest",
          "limit": {
            "context": 256000,
            "output": 4096,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "doubao-seed-code": {
          "name": "doubao-seed-code",
          "limit": {
            "context": 256000,
            "output": 4096,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "glm-5.1": {
          "name": "glm-5.1",
          "limit": {
            "context": 200000,
            "output": 4096,
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 1024000,
            "output": 4096,
          },
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1024000,
            "output": 4096,
          },
        },
        "doubao-seed-2.0-code": {
