          "limit": {
            "context": 256000,
            "output": 4096,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "doubao-seed-2.0-lite": {
          "name": "doubao-seed-2.0-lite",
          "limit": {
            "context": 256000,
            "output": 4096,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "minimax-m2.7": {
          "name": "minimax-m2.7",
